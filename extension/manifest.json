{
  "manifest_version": 3,
  "name": "Retomazera Coletor",
  "version": "2.0",
  "description": "Todo dia às 07:00 copia as mensagens desde a coleta anterior (WhatsApp Web, Marketplace do Facebook, chat da OLX) para o Retomazera no PC. Só leitura.",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://www.facebook.com/*",
    "https://chat.olx.com.br/*",
    "http://127.0.0.1:8797/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
